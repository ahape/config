            "historySize": 32000,
            "intenseTextStyle": "bold",
            "opacity": 90,
            "padding": "10, 6, 10, 6",
            "showMarksOnScrollbar": true,
            "startingDirectory": "c:/src/projects",
            "useAcrylic": true
        },
